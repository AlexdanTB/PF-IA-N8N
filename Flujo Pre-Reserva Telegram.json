      "parameters": {
        "html": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Confirmación de reserva</title>\n    <style>\n        /* Reset y estilos base */\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            background-color: #e6e9ef;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            font-family: 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;\n            padding: 20px;\n        }\n\n        /* Hoja A4 (210mm x 297mm) con sombra y fondo blanco */\n        .a4-container {\n            width: 210mm;\n            min-height: 297mm;\n            background: #ffffff;\n            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);\n            border-radius: 4px;\n            padding: 18mm 16mm 16mm 16mm;  /* márgenes interiores típicos */\n            display: flex;\n            flex-direction: column;\n            transition: all 0.2s;\n            /* Forzar salto de página limpio al imprimir */\n            page-break-after: always;\n        }\n\n        /* Tipografías y colores */\n        .confirmation-header {\n            text-align: center;\n            margin-bottom: 12mm;\n            border-bottom: 2px solid #2c3e50;\n            padding-bottom: 6mm;\n        }\n\n        .confirmation-header h1 {\n            font-size: 28px;\n            font-weight: 600;\n            letter-spacing: 2px;\n            color: #1e2b37;\n            text-transform: uppercase;\n            margin-bottom: 3mm;\n        }\n\n        .confirmation-header .subtitle {\n            font-size: 14px;\n            color: #5e6f7e;\n            letter-spacing: 1px;\n            font-weight: 400;\n            text-transform: uppercase;\n        }\n\n        /* Bloque de número de confirmación destacado */\n        .confirmation-number-box {\n            background-color: #f1f5f9;\n            border-left: 6px solid #2c3e50;\n            padding: 5mm 6mm;\n            margin-bottom: 10mm;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            border-radius: 0 8px 8px 0;\n        }\n\n        .confirmation-number-box .label {\n            font-size: 16px;\n            font-weight: 600;\n            color: #1e2b37;\n            text-transform: uppercase;\n            letter-spacing: 0.5px;\n        }\n\n        .confirmation-number-box .value {\n            font-size: 22px;\n            font-weight: 700;\n            font-family: 'Courier New', monospace;\n            background: #ffffff;\n            padding: 2mm 6mm;\n            border-radius: 30px;\n            color: #0b2b3b;\n            border: 1px solid #b0c4d9;\n            letter-spacing: 1.5px;\n        }\n\n        /* Filas de información general */\n        .info-grid {\n            display: flex;\n            flex-direction: column;\n            gap: 4mm;\n            margin-bottom: 10mm;\n        }\n\n        .info-row {\n            display: flex;\n            align-items: baseline;\n            border-bottom: 1px dashed #cbd5e1;\n            padding-bottom: 2.5mm;\n        }\n\n        .info-row .info-label {\n            width: 55mm;\n            font-weight: 600;\n            color: #2c3e50;\n            font-size: 15px;\n            letter-spacing: 0.3px;\n            flex-shrink: 0;\n        }\n\n        .info-row .info-value {\n            font-size: 15px;\n            color: #1e2b37;\n            font-weight: 500;\n            flex: 1;\n            word-break: break-word;\n        }\n\n        /* Sección de detalles del servicio (destacada) */\n        .service-details {\n            background-color: #f8fafc;\n            border: 1px solid #dbe4ed;\n            border-radius: 12px;\n            padding: 8mm 7mm;\n            margin-bottom: 10mm;\n        }\n\n        .service-details h2 {\n            font-size: 18px;\n            font-weight: 600;\n            color: #1e2b37;\n            margin-bottom: 5mm;\n            display: flex;\n            align-items: center;\n            gap: 3mm;\n            border-bottom: 1px solid #d0ddee;\n            padding-bottom: 3mm;\n        }\n\n        .service-details h2::before {\n            content: \"📋\";\n            font-size: 20px;\n        }\n\n        .service-details .detail-item {\n            display: flex;\n            margin-bottom: 3.5mm;\n            font-size: 15px;\n        }\n\n        .service-details .detail-item .detail-label {\n            width: 45mm;\n            font-weight: 600;\n            color: #2c3e50;\n            flex-shrink: 0;\n        }\n\n        .service-details .detail-item .detail-value {\n            color: #1e2b37;\n            font-weight: 500;\n            flex: 1;\n        }\n\n        /* Términos y condiciones */\n        .terms-section {\n            margin-bottom: 10mm;\n            background-color: #fefcf5;\n            border-left: 5px solid #e6b12e;\n            padding: 6mm 7mm;\n            border-radius: 0 12px 12px 0;\n        }\n\n        .terms-section h3 {\n            font-size: 16px;\n            font-weight: 600;\n            color: #1e2b37;\n            margin-bottom: 4mm;\n            display: flex;\n            align-items: center;\n            gap: 2mm;\n            text-transform: uppercase;\n            letter-spacing: 0.5px;\n        }\n\n        .terms-section h3::before {\n            content: \"⚖️\";\n            font-size: 18px;\n        }\n\n        .terms-section ul {\n            list-style-type: none;\n            padding-left: 0;\n        }\n\n        .terms-section li {\n            font-size: 13.5px;\n            color: #2d3f4e;\n            margin-bottom: 3mm;\n            line-height: 1.5;\n            display: flex;\n            gap: 3mm;\n        }\n\n        .terms-section li::before {\n            content: \"•\";\n            color: #e6b12e;\n            font-weight: 700;\n            font-size: 18px;\n            line-height: 1;\n        }\n\n        /* Información de contacto */\n        .contact-section {\n            margin-top: auto;\n            border-top: 1px solid #cbd5e1;\n            padding-top: 6mm;\n            display: flex;\n            flex-wrap: wrap;\n            justify-content: space-between;\n            align-items: flex-start;\n            gap: 6mm;\n        }\n\n        .contact-block {\n            flex: 1;\n            min-width: 60mm;\n        }\n\n        .contact-block h4 {\n            font-size: 14px;\n            font-weight: 600;\n            color: #1e2b37;\n            margin-bottom: 3mm;\n            text-transform: uppercase;\n            letter-spacing: 0.6px;\n            display: flex;\n            align-items: center;\n            gap: 2mm;\n        }\n\n        .contact-block h4::before {\n            content: \"📞\";\n            font-size: 16px;\n        }\n\n        .contact-block p {\n            font-size: 14px;\n            color: #2d3f4e;\n            margin-bottom: 2mm;\n            line-height: 1.5;\n        }\n\n        .contact-block .highlight {\n            font-weight: 600;\n            color: #1e2b37;\n        }\n\n        .contact-block a {\n            color: #1e5a7a;\n            text-decoration: none;\n            font-weight: 500;\n            border-bottom: 1px dotted #8ba0b5;\n        }\n\n        /* Pie de página sutil */\n        .footer-note {\n            margin-top: 6mm;\n            font-size: 10px;\n            color: #8c9aa8;\n            text-align: center;\n            letter-spacing: 0.5px;\n            border-top: 1px solid #e2e8f0;\n            padding-top: 4mm;\n        }\n\n        /* Estilos específicos para impresión: A4 sin sombras ni fondos externos */\n        @media print {\n            body {\n                background-color: #ffffff;\n                padding: 0;\n                margin: 0;\n                display: block;\n            }\n\n            .a4-container {\n                box-shadow: none;\n                border-radius: 0;\n                width: 210mm;\n                min-height: 297mm;\n                padding: 18mm 16mm 16mm 16mm;\n                margin: 0 auto;\n                page-break-after: always;\n            }\n\n            .confirmation-number-box .value {\n                background: #ffffff;\n                border: 1px solid #a0b8cc;\n            }\n\n            .service-details {\n                background: #ffffff;\n                border: 1px solid #c0d0e0;\n            }\n\n            .terms-section {\n                background: #ffffff;\n                border-left: 5px solid #c0a050;\n            }\n\n            .contact-block a {\n                color: #000000;\n                border-bottom: 1px dotted #000000;\n            }\n        }\n\n        /* Ajuste para pantallas pequeñas: scroll horizontal si es necesario */\n        @media screen and (max-width: 800px) {\n            body {\n                padding: 10px;\n            }\n            .a4-container {\n                width: 100%;\n                min-height: auto;\n                padding: 12mm 10mm;\n            }\n            .info-row {\n                flex-direction: column;\n                gap: 1.5mm;\n            }\n            .info-row .info-label {\n                width: 100%;\n            }\n            .confirmation-number-box {\n                flex-direction: column;\n                align-items: flex-start;\n                gap: 3mm;\n            }\n            .contact-section {\n                flex-direction: column;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"a4-container\">\n        <!-- Encabezado -->\n        <div class=\"confirmation-header\">\n          <svg id=\"Capa_2\" height=80 data-name=\"Capa 2\" xmlns=\"http://www.w3.org/2000/sv