      "parameters": {
        "jsCode": "// Captura el texto entrante y datos del cliente\nconst inputMessage = $json.message?.text || \"\";\nconst chatId = $json.message?.chat?.id;\nconst senderName = $json.message?.from?.first_name || \"Cliente\";\n\n// Validación de entrada\nif (!inputMessage.trim()) {\n  throw new Error(\"El mensaje recibido está vacío.\");\n}\n\nreturn {\n  json: {\n    chat_id: chatId,\n    cliente_nombre: senderName,\n    mensaje_raw: inputMessage,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
